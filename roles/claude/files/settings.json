{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Glob(**)",
      "Grep(**)",
      "LS(**)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(less *)",
      "Bash(more *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(env *)",
      "Bash(xargs *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(make *)",
      "Bash(cargo *)",
      "Bash(uv *)",
      "Bash(pytest *)",
      "Bash(ansible-playbook *)",
      "Bash(ansible-lint *)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod 777:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.cert)"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "context-engineering-fundamentals@context-engineering-marketplace": true,
    "agent-architecture@context-engineering-marketplace": true,
    "agent-evaluation@context-engineering-marketplace": true,
    "agent-development@context-engineering-marketplace": true,
    "cognitive-architecture@context-engineering-marketplace": true,
    "fullstack-dev-skills@fullstack-dev-skills": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": false
}
